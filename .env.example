# ---------- Frontend (Vite) ----------
# Render API base URL used in production builds (leave empty for local dev)
VITE_API_BASE_URL=

# Agora App ID exposed to the browser (public, safe to embed).
# Must be set for video consultation to connect.
VITE_AGORA_APP_ID=

# ---------- Backend (server/) ----------
# Copy server/.env.example → server/.env and fill in real values before starting the server.