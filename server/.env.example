# ---------- NYAYAI Backend ----------
PORT=5001

# JWT authentication (production MUST set a real secret ≥16 characters).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# PostgreSQL (optional; if omitted the server uses an on-disk JSON file store)
DATABASE_URL=
DATABASE_SSL=false

# JSON file store override (no trailing slash). Only used when DATABASE_URL is unset.
NYAYAI_DATA_DIR=

# LLM
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini

# Video consultation
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# CORS: comma-separated list of frontend origins. Falls back to reflect request origin.
CORS_ORIGIN=
CLIENT_ORIGIN=http://localhost:5173

# ---------- Phase 9: Legal corpus + retrieval + RAG ----------
# Vector DB (Phase 8 C++ component)
VECTOR_DB_URL=http://127.0.0.1:5400
VECTOR_DB_TIMEOUT_MS=30000

# Corpus source. Use "s3" ONLY with a real bucket; otherwise the server uses
# a local deterministic fixture tree and clearly reports "fixtures".
#   CORPUS_SOURCE=s3  ->  real S3 (needs AWS credentials below)
#   CORPUS_SOURCE=    ->  local fixtures at server/fixtures/legal-corpus
CORPUS_SOURCE=
S3_BUCKET=nyayai-legal-corpus
S3_CORPUS_PREFIX=nyayai-legal-corpus
# Custom endpoint + path-style addressing for MinIO / LocalStack (optional).
S3_ENDPOINT=
# Standard AWS auth: use AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# or an IAM role / ~/.aws config. NEVER commit credentials.

# Embedding provider. "ollama" (default when OLLAMA_URL set) or "fixture".
LEGAL_EMBEDDING_PROVIDER=fixture
LEGAL_EMBEDDING_DIM=64
OLLAMA_URL=
LEGAL_OLLAMA_MODEL=nomic-embed-text
LEGAL_OLLAMA_TIMEOUT=60000

# RAG responder: "groq" (needs GROQ_API_KEY) or "fixture" (deterministic tests).
LEGAL_RAG_PROVIDER=fixture
